{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-constant-condition": ["warn", { "checkLoops": false }]
  },
  "globals": {
    "self": "readonly",
    "caches": "readonly",
    "clients": "readonly"
  }
}
